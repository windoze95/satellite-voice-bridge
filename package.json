{
  "name": "satellite-voice-bridge",
  "version": "0.1.0",
  "description": "Low-latency voice bridge: Satellite1 wake-word audio → OpenAI Realtime (function calling, no TTS) → policy engine → Home Assistant",
  "type": "module",
  "license": "MIT",
  "author": "windoze95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windoze95/satellite-voice-bridge.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "voicebridge": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "esphome-client": "2.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
