# Copy to .env and fill in. The real .env is gitignored and must never be committed.

# OpenAI API key from a dedicated, budget-capped project (platform.openai.com)
OPENAI_API_KEY=

# Home Assistant base URL, e.g. http://homeassistant.local:8123
HA_URL=

# Long-lived access token minted by an ADMIN Home Assistant user
# (Profile → Security → Long-lived access tokens). Admin is required for
# registry-change subscriptions.
HA_TOKEN=

# Optional overrides
#VOICEBRIDGE_MODEL=gpt-realtime-2.1-mini
#VOICEBRIDGE_CONFIG=./voicebridge.yaml
#VOICEBRIDGE_FFMPEG=/opt/homebrew/bin/ffmpeg
#VOICEBRIDGE_REALTIME_URL=wss://api.openai.com/v1/realtime
